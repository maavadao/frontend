# Copy to .env.local. For the local stack, use the values `supabase start` prints
# (run it from the maavadao folder). Read on the server at runtime; in production
# they come from Secret Manager on Cloud Run.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# maava AI (/chat): free open models for signed-in members, through maavaDao's llm-router
# (github.com/maavadao/llm-router). On Cloud Run these come from Secret Manager. Without
# LLM_ROUTER_URL, /chat says maava AI isn't switched on yet.
LLM_ROUTER_URL=http://localhost:8080
LLM_ROUTER_TOKEN=
# Optional: CHAT_DAILY_LIMIT (messages per member per day, default 50)
