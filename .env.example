# Copy to .env.local. For the local stack, use the values `supabase start` prints
# (run it from the maavadao folder). Read on the server at runtime; in production
# they come from Secret Manager on Cloud Run.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# maavaDao Chat (/chat): free Claude access for signed-in members. On Cloud Run the key
# comes from Secret Manager. Without it, /chat says chat isn't switched on yet.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: CHAT_MODEL (default claude-opus-5-5), CHAT_DAILY_LIMIT (messages per member per day, default 50)
